# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Distribution / packaging
build/
dist/
*.egg-info/

# Testing and linting caches
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Raw dataset files
data/raw/
*.idx1-ubyte
*.idx3-ubyte
*.gz

# Virtual environment
venv/
.venv/
env/

# IDE / Editor files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Explicitly do NOT ignore models/ and tests/fixtures/
!models/
!models/**
!tests/fixtures/
!tests/fixtures/**
